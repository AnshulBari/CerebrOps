# Environment variables for CerebrOps
# Copy this file to .env and fill in your values

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Application Configuration
APP_URL=http://localhost:5000
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Authentication
CEREBROPS_API_KEY=your-secret-api-key-here

# Monitoring Configuration
ANOMALY_THRESHOLD=0.1
MONITORING_INTERVAL=300
ANOMALY_WINDOW_SIZE=200
ANOMALY_MIN_SAMPLES=10

# Anomaly Model (Phase 2)
# CEREBROPS_MODEL_DIR=/absolute/path/to/models
ANOMALY_DRIFT_THRESHOLD=0.25
# Retraining schedule (seconds): min interval (anti-thrash), max interval (safety net)
RETRAIN_MIN_INTERVAL=3600
RETRAIN_MAX_INTERVAL=604800

# Forecast-Residual Detector (Phase 5, AI v2)
# Activates only once >= FORECAST_MIN_HISTORY_DAYS of real history exists,
# with enough observations per hour-of-week bucket for a stable seasonal profile.
FORECAST_MIN_HISTORY_DAYS=7
FORECAST_MIN_OBS_PER_BUCKET=3
FORECAST_Z_THRESHOLD=4.0
# Points above this z-score are flagged unconditionally; between
# Z_THRESHOLD and HARD, only when an adjacent point also breaches.
FORECAST_HARD_Z_THRESHOLD=5.0

# LLM anomaly summaries (Phase 5) - opt-in; disabled when LLM_API_URL is unset.
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key
# LLM_MODEL=gpt-4o-mini

# Telemetry Store (SQLite)
# CEREBROPS_DB_PATH=/absolute/path/to/cerebrops.db

# Database Configuration (if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/cerebrops

# ELK Configuration
ELASTICSEARCH_HOST=localhost:9200
KIBANA_HOST=localhost:5601
LOGSTASH_HOST=localhost:5044
ELASTIC_PASSWORD=changeme

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Docker Configuration
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=cerebrops

# Kubernetes Configuration
K8S_NAMESPACE=cerebrops
K8S_CLUSTER_NAME=cerebrops-cluster
